<br.com.cinematch.ui.MaxWidthLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:tag="wide" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:orientation="horizontal" android:baselineAligned="false" android:paddingHorizontal="16dp">
    <ScrollView android:id="@+id/scroll" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="match_parent" android:scrollbars="none" android:layout_marginEnd="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/empty" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:text="@string/v2_activity_discovery_3" android:visibility="gone"/>
            <include android:id="@+id/movie" layout="@layout/movie_card"/>
        </LinearLayout>
    </ScrollView>
    <ScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical">
            <TextView style="@style/Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/v2_activity_discovery_1"/>
            <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/v2_activity_discovery_2" android:textSize="23sp"/>
            <TextView android:id="@+id/counter" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11sp"/>
            <LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
                    <com.google.android.material.button.MaterialButton android:id="@+id/skip" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="@string/v2_activity_discovery_4" android:textColor="@color/skip" app:icon="@drawable/ic_skip" app:iconTint="@color/skip"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/dislike" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/v2_activity_discovery_5" android:textColor="@color/dislike" app:icon="@drawable/ic_dislike" app:iconTint="@color/dislike"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
                    <com.google.android.material.button.MaterialButton android:id="@+id/watch" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="@string/v2_activity_discovery_6" android:textColor="@color/watch" app:icon="@drawable/ic_watch" app:iconTint="@color/watch"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/like" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/v2_activity_discovery_7" android:textColor="@color/like" app:icon="@drawable/ic_like" app:iconTint="@color/like"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</br.com.cinematch.ui.MaxWidthLayout>
