<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="52dp" android:paddingHorizontal="8dp" app:title="CineMatch" app:titleTextAppearance="@style/ToolbarTitle" app:titleTextColor="@color/text" app:logo="@drawable/ic_brand">
  <TextView android:id="@+id/account" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:background="@drawable/avatar_bg" android:gravity="center" android:textColor="@color/text" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:contentDescription="@string/banner_activity_base_1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless"/>
