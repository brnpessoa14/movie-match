        <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="72dp" android:background="@android:color/transparent" app:elevation="0dp" app:menu="@menu/navigation" app:itemIconSize="22dp" app:labelVisibilityMode="labeled" app:itemTextAppearanceActive="@style/NavLabel" app:itemTextAppearanceInactive="@style/NavLabel" app:itemIconTint="@color/nav_tint" app:itemTextColor="@color/nav_tint"/>
