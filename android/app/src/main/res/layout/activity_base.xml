<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="8dp" app:title="@string/v2_activity_base_1" app:titleTextAppearance="@style/ToolbarTitle" app:titleTextColor="@color/text" app:menu="@menu/account" app:logo="@drawable/ic_brand"/>
