<br.com.cinematch.ui.MaxWidthLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:tag="wide" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp">
    <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_title"/>
    <TextView style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/catalog_hint"/>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/query_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/catalog_query"><com.google.android.material.textfield.TextInputEditText android:id="@+id/query" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="100" android:inputType="text" android:imeOptions="actionSearch"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/catalog_search" app:icon="@drawable/ic_search"/>
    <TextView android:id="@+id/result_count" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp" android:accessibilityLiveRegion="polite"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp"/>
    <LinearLayout android:id="@+id/pages" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false" android:visibility="gone"><com.google.android.material.button.MaterialButton android:id="@+id/previous" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/catalog_previous"/><TextView android:id="@+id/page" style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content"/><com.google.android.material.button.MaterialButton android:id="@+id/next" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/catalog_next"/></LinearLayout>
</br.com.cinematch.ui.MaxWidthLayout>
