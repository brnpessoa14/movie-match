<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_discovery_text_1" android:textSize="11sp" android:letterSpacing="0.09" android:textColor="@color/accent" android:paddingVertical="12dp" />
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/empty" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:text="@string/activity_discovery_text_2" android:visibility="gone" />
            <include android:id="@+id/movie" layout="@layout/movie_card" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/skip" style="@style/Action" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/activity_discovery_text_3" android:textColor="@color/skip" app:strokeColor="@color/skip" />
            <com.google.android.material.button.MaterialButton android:id="@+id/dislike" style="@style/Action" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="@string/activity_discovery_text_4" android:textColor="@color/dislike" app:strokeColor="@color/dislike" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/watch" style="@style/Action" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/activity_discovery_text_5" android:textColor="@color/watch" app:strokeColor="@color/watch" />
            <com.google.android.material.button.MaterialButton android:id="@+id/like" style="@style/Action" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="@string/activity_discovery_text_6" android:textColor="@color/like" app:strokeColor="@color/like" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
