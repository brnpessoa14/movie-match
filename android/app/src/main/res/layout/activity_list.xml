<br.com.cinematch.ui.MaxWidthLayout xmlns:android="http://schemas.android.com/apk/res/android" android:tag="wide" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="@dimen/page_padding" android:paddingTop="12dp">
    <TextView android:id="@+id/eyebrow" style="@style/Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/v2_activity_list_1"/>
    <TextView android:id="@+id/heading" style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="28sp"/>
    <TextView android:id="@+id/description" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <FrameLayout android:id="@+id/filter_container" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/badge_bg" android:visibility="gone">
        <Spinner android:id="@+id/filter" android:layout_width="match_parent" android:layout_height="match_parent" android:popupBackground="@color/surface" android:contentDescription="@string/v2_activity_list_2"/>
    </FrameLayout>
    <TextView android:id="@+id/empty" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="32dp" android:visibility="gone" android:text="@string/v2_activity_list_3"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="20dp" android:clipToPadding="false" android:paddingBottom="16dp" android:scrollbars="none"/>
</br.com.cinematch.ui.MaxWidthLayout>
