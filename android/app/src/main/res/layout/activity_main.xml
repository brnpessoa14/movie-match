<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
<br.com.cinematch.ui.MaxWidthLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:baselineAligned="false">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_brand" android:contentDescription="@string/v2_activity_main_1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/v2_activity_main_2" android:textColor="@color/text" android:textSize="21sp" android:fontFamily="sans-serif-medium"/>
        <TextView style="@style/Eyebrow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:text="@string/v2_activity_main_3"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/login_hero_height" android:layout_marginVertical="12dp" android:clipChildren="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:baselineAligned="false" android:padding="8dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="8dp" android:rotation="-4" app:cardCornerRadius="10dp" app:strokeWidth="0dp"><ImageView android:id="@+id/hero_left" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/poster_placeholder" android:contentDescription="@string/v2_activity_main_4"/></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="match_parent" android:layout_marginHorizontal="4dp" android:translationY="-8dp" app:cardCornerRadius="10dp" app:strokeWidth="0dp"><ImageView android:id="@+id/hero_center" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/poster_placeholder" android:contentDescription="@string/v2_activity_main_5"/></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="8dp" android:rotation="4" app:cardCornerRadius="10dp" app:strokeWidth="0dp"><ImageView android:id="@+id/hero_right" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/poster_placeholder" android:contentDescription="@string/v2_activity_main_6"/></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/welcome" style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/v2_activity_main_7" android:textSize="28sp"/>
    <TextView android:id="@+id/subtitle" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/v2_activity_main_8"/>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/auth_tabs" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/login_tab">
        <com.google.android.material.button.MaterialButton android:id="@+id/login_tab" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/v2_activity_main_9" android:textAllCaps="false" app:cornerRadius="12dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/register_tab" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/v2_activity_main_10" android:textAllCaps="false" app:cornerRadius="12dp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/name_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/v2_activity_main_11" android:visibility="gone"><com.google.android.material.textfield.TextInputEditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords" android:maxLength="80" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/username_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/v2_activity_main_12"><com.google.android.material.textfield.TextInputEditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textVisiblePassword" android:maxLength="32" android:singleLine="true" android:saveEnabled="false"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/password_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/v2_activity_main_13" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="128" android:singleLine="true" android:saveEnabled="false"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirm_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/v2_activity_main_14" android:visibility="gone" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/confirm_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="128" android:singleLine="true" android:saveEnabled="false"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/v2_activity_main_15" app:icon="@drawable/ic_arrow" app:iconGravity="textEnd"/>
    <TextView style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:text="@string/v2_activity_main_16" android:textSize="12sp"/>
</br.com.cinematch.ui.MaxWidthLayout>
</ScrollView>
