<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_preferences_text_1" />
    <TextView style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/activity_preferences_text_2" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp">
        <LinearLayout android:id="@+id/genres" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/activity_preferences_text_3" android:textAllCaps="false" />
</LinearLayout>
