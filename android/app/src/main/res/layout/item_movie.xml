<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
  <ImageView android:id="@+id/poster" android:layout_width="70dp" android:layout_height="105dp" android:scaleType="fitCenter" android:src="@drawable/poster_placeholder" android:contentDescription="@string/banner_dialog_movie_19"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
   <TextView android:id="@+id/title" style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp"/>
   <TextView android:id="@+id/metadata" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp"/>
   <TextView android:id="@+id/ratings" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp"/>
   <TextView android:id="@+id/reason" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/details" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/banner_item_movie_24" app:icon="@drawable/ic_arrow" app:iconGravity="textEnd" app:iconSize="16dp"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/edit_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:baselineAligned="false"><com.google.android.material.button.MaterialButton android:id="@+id/edit" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/banner_item_movie_25"/><com.google.android.material.button.MaterialButton android:id="@+id/delete" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/banner_item_movie_26" android:textColor="@color/muted"/></LinearLayout>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/outline"/>
</LinearLayout>
