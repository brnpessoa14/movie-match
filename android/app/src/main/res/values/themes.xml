<resources>
    <style name="Theme.CineMatch" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item><item name="colorPrimaryVariant">#D94737</item>
        <item name="colorSecondary">@color/accent</item><item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item><item name="colorOnSurface">@color/text</item>
        <item name="android:colorBackground">@color/background</item><item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item><item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item><item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item><item name="android:windowBackground">@color/background</item>
        <item name="materialButtonStyle">@style/PrimaryButton</item>
        <item name="textInputStyle">@style/CinemaInput</item>
    </style>
    <style name="Title"><item name="android:textSize">28sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textColor">@color/text</item><item name="android:lineSpacingExtra">1dp</item></style>
    <style name="Body"><item name="android:textSize">14sp</item><item name="android:textColor">@color/muted</item><item name="android:lineSpacingExtra">2dp</item></style>
    <style name="Eyebrow"><item name="android:textSize">11sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:letterSpacing">0.1</item><item name="android:textColor">@color/accent</item></style>
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button"><item name="cornerRadius">12dp</item><item name="android:minHeight">56dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:letterSpacing">0</item><item name="elevation">0dp</item></style>
    <style name="CinemaInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox"><item name="boxCornerRadiusTopStart">14dp</item><item name="boxCornerRadiusTopEnd">14dp</item><item name="boxCornerRadiusBottomStart">14dp</item><item name="boxCornerRadiusBottomEnd">14dp</item><item name="boxBackgroundColor">@color/surface</item><item name="boxStrokeColor">@color/input_stroke</item><item name="hintTextColor">@color/muted</item></style>
    <style name="Action" parent="Widget.MaterialComponents.Button"><item name="android:textAllCaps">false</item><item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:letterSpacing">0</item><item name="android:minHeight">72dp</item><item name="android:padding">9dp</item><item name="cornerRadius">18dp</item><item name="backgroundTint">@color/surface_raised</item><item name="iconSize">18dp</item><item name="iconPadding">6dp</item></style>
    <style name="ToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title"><item name="android:textSize">19sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textColor">@color/text</item></style>
    <style name="NavLabel" parent="TextAppearance.MaterialComponents.Caption"><item name="android:textSize">11sp</item><item name="android:fontFamily">sans-serif-medium</item></style>

<style name="TextButton" parent="Widget.MaterialComponents.Button.TextButton"><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item><item name="android:textColor">@color/accent</item><item name="android:textSize">14sp</item><item name="android:letterSpacing">0</item></style>
<style name="Segment" parent="Widget.MaterialComponents.Button.OutlinedButton"><item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item><item name="android:minHeight">48dp</item><item name="android:textColor">@color/text</item><item name="backgroundTint">@color/segment_fill</item><item name="strokeColor">@color/outline</item><item name="cornerRadius">12dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item><item name="android:letterSpacing">0</item></style>
<style name="SettingsRow" parent="TextButton"><item name="android:gravity">start|center_vertical</item><item name="android:paddingHorizontal">16dp</item><item name="android:paddingVertical">12dp</item><item name="android:minHeight">60dp</item><item name="android:textColor">@color/text</item><item name="backgroundTint">@color/surface</item><item name="cornerRadius">12dp</item><item name="iconTint">@color/muted</item><item name="iconPadding">14dp</item><item name="iconSize">20dp</item></style></resources>
